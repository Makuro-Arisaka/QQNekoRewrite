<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络权限（API 连通性测试） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Xposed 模块声明 -->
    <application
        android:allowBackup="false"
        android:supportsRtl="true"
        android:label="QQ NekoRewrite"
        android:icon="@mipmap/ic_launcher"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.NekoRewrite">

        <!-- Xposed/LSPosed 模块元数据 -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />

        <meta-data
            android:name="xposeddescription"
            android:value="QQ 猫娘 AI 改写模块 — 将发送的消息自动改写为猫娘口吻" />

        <meta-data
            android:name="xposedminversion"
            android:value="82" />

        <!-- 可选：模块设置界面 -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- 设置界面 — 可从桌面启动 -->
        <activity
            android:name="com.neko.rewrite.MainActivity"
            android:exported="true"
            android:label="QQ NekoRewrite"
            android:theme="@style/Theme.NekoRewrite">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings 磁贴：一键启停猫娘改写（由 SystemUI 托管，不受 QQ 进程影响） -->
        <service
            android:name="com.neko.rewrite.QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_neko"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TILE_ID"
                android:value="neko_rewrite_tile" />
            <meta-data
                android:name="android.service.quicksettings.TILE_LABEL"
                android:resource="@string/tile_label" />
            <meta-data
                android:name="android.service.quicksettings.TILE_ICON"
                android:resource="@drawable/ic_tile_neko" />
        </service>
    </application>

</manifest>